{
    "name": "9in/php-sdk",
    "type": "library",
    "description": "Official 9in PHP SDK: OpenID Connect sign-in with PKCE, local access-token verification, Management API client, adapter v2 handler and webhook verification.",
    "keywords": [
        "9in",
        "sso",
        "login",
        "auth",
        "authentication",
        "oauth2",
        "openid-connect",
        "oidc",
        "pkce",
        "jwt",
        "webhooks",
        "sdk"
    ],
    "homepage": "https://9in.io",
    "license": "MIT",
    "authors": [
        {
            "name": "9in",
            "email": "support@9in.io"
        },
        {
            "name": "Cubelet Ltd.",
            "email": "info@cubelet.co.uk"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.13",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Nine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nine\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-fixer": "php-cs-fixer fix"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.x-dev"
        }
    }
}
